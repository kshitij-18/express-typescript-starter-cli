{
  "name": "{{projectName}}",
  "description": "{{projectDescription}}",
  "packageManager": "{{packageManager}}@{{packageManagerVersion}}",
  "author": "{{authorName}}",
  "type": "module",
  "version": "1.0.0",
  "dependencies": {
  "express": "latest",
  "dotenv": "latest",
  "cors": "latest",
  "morgan": "latest"{{#if includeTesting}},
  "jest": "latest",
  "ts-jest": "latest",
  "@types/jest": "latest"{{/if}}{{#if (eq dbChoice 'mongodb')}},
  "mongodb": "latest",
  "mongoose": "latest"{{/if}}{{#if (eq dbChoice 'postgresql')}},
  "pg": "latest",
  "sequelize": "latest",
  "sequelize-typescript": "latest"{{/if}}{{#if (eq dbChoice 'mysql')}},
  "mysql2": "latest",
  "sequelize": "latest"{{/if}},
  "typescript": "latest",
  "ts-node": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/express": "latest",
    "@types/cors": "latest",
    "@types/morgan": "latest",
    "globals": "latest",
    "ts-node-dev": "latest",
    "typescript": "latest"{{#if includeEslint}},
    "typescript-eslint": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "@eslint/js": "latest",
    "eslint": "latest",
    "eslint-config-airbnb": "latest",
    "eslint-config-airbnb-base": "latest"{{/if}}{{#if includePrettier}},
    "prettier": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-prettier": "latest"{{/if}}
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean"{{#if includeTesting}},
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"{{/if}}{{#if includeEslint}},
    "lint": "eslint . --ext .ts,.js,.mjs",
    "lint:fix": "eslint . --ext .ts,.js,.mjs --fix",
    "lint:check": "eslint . --ext .ts,.js,.mjs --max-warnings 0"{{/if}}{{#if includePrettier}},
    "format": "prettier --write .",
    "format:check": "prettier --check ."{{/if}}{{#if includeDocker}},
    "docker:build": "docker build -t {{projectName}} .",
    "docker:run": "docker run -p 3000:3000 {{projectName}}"{{/if}}
  }
}