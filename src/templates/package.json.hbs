{
  "name": "{{projectName}}",
  "packageManager": "{{packageManager}}@latest",
  "author": "{{authorName}}",
  "type": "module",
  "version": "1.0.0",
  "dependencies": {
  "express": "latest",
  "dotenv": "latest",
  "cors": "latest",
  "morgan": "latest"{{#if includeTesting}},
  "jest": "latest",
  "ts-jest": "latest"{{/if}}{{#if (eq dbChoice 'mongodb')}},
  "mongodb": "latest",
  "mongoose": "latest"{{/if}}{{#if (eq dbChoice 'postgresql')}},
  "pg": "latest",
  "sequelize": "latest",
  "sequelize-typescript": "latest"{{/if}}{{#if (eq dbChoice 'mysql')}},
  "mysql2": "latest",
  "sequelize": "latest"{{/if}},
  "typescript": "latest",
  "ts-node": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "globals": "latest",
    "ts-node-dev": "latest",
    "typescript": "latest"{{#if includeEslint}},
    "typescript-eslint": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "@eslint/js": "latest",
    "eslint": "latest",
    "eslint-config-airbnb": "latest",
    "eslint-config-airbnb-base": "latest"{{/if}}{{#if includePrettier}},
    "prettier": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-prettier": "latest"{{/if}}
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.js,.mjs",
    "lint:fix": "eslint . --ext .ts,.js,.mjs --fix",
    "lint:check": "eslint . --ext .ts,.js,.mjs --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "build:check": "yarn type-check && yarn lint:check && yarn format:check",
    "start": "node dist/bin/cli.js",
    "dev": "ts-node-dev --respawn --transpile-only bin/cli.ts",
    "clean": "rm -rf dist",
    "prebuild": "yarn clean"
  }
}