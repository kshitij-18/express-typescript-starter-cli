{
  "name": "@kshitij05/express-typescript-starter",
  "packageManager": "yarn@4.9.1",
  "type": "module",
  "version": "1.0.3",
  "description": "CLI tool to create Express TypeScript boilerplate projects",
  "keywords": [
    "express",
    "typescript",
    "boilerplate",
    "cli",
    "generator"
  ],
  "author": "Kshitij",
  "license": "MIT",
  "bin": {
    "create-express-typescript": "./dist/bin/cli.js"
  },
  "files": [
    "dist/**/*",
    "src/templates/**/*"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.8.3",
    "chalk": "^5.5.0",
    "commander": "^14.0.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.33.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.js,.mjs",
    "lint:fix": "eslint . --ext .ts,.js,.mjs --fix",
    "lint:check": "eslint . --ext .ts,.js,.mjs --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "build:check": "yarn type-check && yarn lint:check && yarn format:check",
    "start": "node dist/bin/cli.js",
    "dev": "ts-node-dev --respawn --transpile-only bin/cli.ts",
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "prepublishOnly": "npx tsc",
    "prepack": "npx tsc"
  }
}
